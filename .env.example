# Example environment file. Copy to `.env` and fill in your own values.
# No value here is real; every field is a placeholder.

# --- Google Sheets / Drive (OAuth token path) ---
GOOGLE_TOKEN_JSON=google_token.json

# --- LLM (OpenAI-compatible; DeepSeek shown as example) ---
DEEPSEEK_API_KEY=YOUR_LLM_API_KEY
# Optional: point at any OpenAI-compatible base URL
# LLM_BASE_URL=https://api.deepseek.com/v1

# --- WordPress (v2/v3/v3.1 insert modes) ---
WP_SITE_URL=https://YOUR_SITE.com
WP_USER=YOUR_WP_USER
WP_APP_PASSWORD=YOUR_WP_APP_PASSWORD

# --- Digest webhook (v3.1 --notify; optional) ---
# N8N_DIGEST_WEBHOOK=https://YOUR_N8N_HOST/webhook/internal-linker-digest
